# Copy outside the public static directory. Never commit real values.
MODEL_API_KEY=
MODEL_BASE_URL=https://YOUR-PROVIDER/v1
MODEL_NAME=YOUR-PROVIDER-MODEL-ID
ALLOWED_ORIGINS=https://jasjs96211-alt.github.io
DAILY_REQUEST_LIMIT=60
MINUTE_REQUEST_LIMIT=6
# Fill current supplier prices per million tokens, in the same currency.
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
DAILY_BUDGET=5
COST_CURRENCY=USD
# Local mode is default. Remote mode requires every field below plus positive prices.
REMOTE_MODE=false
PUBLIC_HOSTS=chat.YOUR-DOMAIN
SUPABASE_URL=https://myejuodrhgdxphdkrvsa.supabase.co
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_USER_IDS=
# One process, one durable private directory; shared deployments need a transactional DB.
PROXY_LEDGER_FILE=/var/lib/yuanhang-chat/calls.ledger.json
PORT=8787
